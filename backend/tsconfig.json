{
  "compilerOptions": {
    /* === Output & Module System === */
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",

    /* === TypeScript Behavior === */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* === Node.js Environment === */
    "moduleResolution": "node",
    "resolveJsonModule": true,

    /* === Source Maps (optional, good for debugging) === */
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
